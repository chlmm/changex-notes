#ifdef _WIN32
bool {{CLASS_NAME}}::winsock_initialized_ = {{CLASS_NAME}}::initializeWinsock();

bool {{CLASS_NAME}}::initializeWinsock() {
    WSADATA wsaData;
    return WSAStartup(MAKEWORD(2, 2), &wsaData) == 0;
}
